    "models": {
      "surveyTypes": "Each Survey Type is one of the three magic-link instruments — Tool Intake, Financial, Usage — scoped to this project. Carries response and completion counts, public-blast-link state, in-progress/overdue counters, and the timestamp of the last response activity. Drives the three top survey-type cards.",
      "responses": "Each Response is one respondent's submission for one survey type. Captures status (in-progress / submitted / overdue / not-started), step progress for cross-device resume, channel (magic-link or public-link), and the latest activity. Drives the responses table.",
      "respondents": "Each Respondent is a person at the prospect company invited to share input. Used to render the avatar + name + role pill on each table row, quote, and transcript.",
      "quotes": "Each Quote is a verbatim answer a reviewer flagged as standout — pinned for re-use in proposals. Belongs to one response and one respondent.",
      "transcripts": "Each Transcript is a follow-up call recording or paste uploaded against this project's respondents. Source, duration, and a status that walks uploaded → transcribing → ready → reviewed.",
      "reviewers": "Internal Ravn users who pinned quotes — used for avatar lookup in the Standout Quotes panel."
    },
    "relationships": [
      "Each Response belongs to one Respondent (respondentId) and references one Survey Type (surveyType).",
      "Each Quote is tied to one Response (responseId) and one Respondent (respondentId), and was Pinned by one Reviewer (pinnedById).",
      "Each Transcript references one Respondent (respondentId).",
      "The three Survey Type Cards summarise responses across all Respondents in the project — counts roll up from the Responses array."
    ]
  },
