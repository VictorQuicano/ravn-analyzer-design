  "_meta": {
    "models": {
      "stats": "The four headline KPIs across the top of the dashboard — prospect count, total SaaS spend currently being analyzed, count of qualified Rip opportunities, and total engagement value in the active pipeline. Each carries a 30-day delta and a 12-point sparkline.",
      "projects": "Each Project is a prospect company in the pipeline. Carries owner, current pipeline stage, heat tier, captured SaaS spend, blended Rip score, next-upcoming renewal, and a last-activity timestamp. Drives the prospect list table.",
      "opportunities": "Each Opportunity is a Rip Opportunity in the pipeline at a specific stage. Belongs to one Project. Drives the kanban board — cards group by stage and roll up by engagement value per column.",
      "renewals": "Each Renewal is an upcoming SaaS contract end date for one project's SaasApplication, bucketed by days-until-renewal into the four urgency bands shown on the renewal calendar.",
      "owners": "Internal Ravn users who own projects — used to render avatar initials and the owner filter dropdown."
    },
    "relationships": [
      "Each Project is owned by one Owner (ownerEmail).",
      "Each Project has one Pipeline Stage and one Heat Tier (the row badges).",
      "Each Opportunity belongs to one Project (projectId) and lives in exactly one Pipeline Stage column on the kanban.",
      "Each Renewal belongs to one Project (projectId) and references a single SaaS application by name.",
      "The Stats summary is computed across all Projects + Opportunities — the dashboard rolls them up at the top."
    ]
  },
